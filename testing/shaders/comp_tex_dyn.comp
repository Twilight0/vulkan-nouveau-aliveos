#version 450
layout(local_size_x = 4, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D u_tex[2];

layout(set = 0, binding = 1) writeonly buffer OutBuf {
    uvec4 data[];
} out_buf;

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint idx = i & 1u;
    ivec2 sz = textureSize(u_tex[idx], 0);
    vec4 c = texelFetch(u_tex[idx], ivec2(0, 0), 0);
    out_buf.data[i] = uvec4(uint(sz.x), uint(sz.y),
                            uint(c.r * 255.0 + 0.5),
                            uint(c.g * 255.0 + 0.5));
}
