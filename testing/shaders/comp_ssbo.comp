#version 450
layout(local_size_x = 16, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InBuf {
    uint data[];
} in_buf;

layout(set = 0, binding = 1) writeonly buffer OutBuf {
    uint data[];
} out_buf;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    out_buf.data[idx] = in_buf.data[idx] * 2u + idx + 7u;
}
