#version 450
layout(local_size_x = 4, local_size_y = 4, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) writeonly uniform image2D u_out_img;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    vec4 color = vec4(float(p.x) / 3.0, float(p.y) / 3.0, 0.5, 1.0);
    imageStore(u_out_img, p, color);
}
